{
  "name": "@zutools/react",
  "version": "0.1.0",
  "description": "Local-first browser tools and an embeddable React catalogue for ZU Tools.",
  "keywords": [
    "local-first",
    "browser-tools",
    "privacy",
    "react",
    "components",
    "typescript",
    "word-counter",
    "toolkit"
  ],
  "author": "ZU Tools contributors",
  "homepage": "https://usezutools.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usezutools/zutools.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/usezutools/zutools/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./free": {
      "types": "./dist/free.d.ts",
      "import": "./dist/free.js",
      "default": "./dist/free.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./implementations": {
      "types": "./dist/implementations/index.d.ts",
      "import": "./dist/implementations.js",
      "default": "./dist/implementations.js"
    },
    "./styles.css": "./dist/index.css",
    "./workspace.css": "./dist/implementations.css",
    "./word-counter": {
      "types": "./dist/word-counter.d.ts",
      "import": "./dist/word-counter.js",
      "default": "./dist/word-counter.js"
    },
    "./word-counter.css": "./dist/word-counter.css"
  },
  "dependencies": {
    "@zutools/core": "0.1.0"
  },
  "peerDependencies": {
    "lucide-react": ">=0.400.0",
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs && tsc -p tsconfig.build.json",
    "test": "node -e \"Promise.all([import('@zutools/core'), import('./dist/index.js')]).then(() => console.log('Compiled packages resolved'))\"",
    "prepack": "npm run build && npm test"
  }
}
