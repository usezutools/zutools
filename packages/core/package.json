{
  "name": "@zutools/core",
  "version": "0.1.0",
  "description": "Framework-agnostic local-first engines and catalogue for ZU Tools.",
  "keywords": [
    "local-first",
    "browser-tools",
    "privacy",
    "utilities",
    "typescript",
    "esm",
    "word-counter",
    "csv",
    "base64"
  ],
  "author": "ZU Tools contributors",
  "homepage": "https://usezutools.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/usezutools/zutools.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/usezutools/zutools/issues"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./base64": {
      "types": "./dist/base64.d.ts",
      "import": "./dist/base64.js",
      "default": "./dist/base64.js"
    },
    "./catalog": {
      "types": "./dist/catalog.d.ts",
      "import": "./dist/catalog.js",
      "default": "./dist/catalog.js"
    },
    "./catalog.json": "./dist/catalog/tools.json",
    "./csv": {
      "types": "./dist/csv.d.ts",
      "import": "./dist/csv.js",
      "default": "./dist/csv.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js",
      "default": "./dist/image.js"
    },
    "./image-metadata": {
      "types": "./dist/image-metadata.d.ts",
      "import": "./dist/image-metadata.js",
      "default": "./dist/image-metadata.js"
    },
    "./json": {
      "types": "./dist/json.d.ts",
      "import": "./dist/json.js",
      "default": "./dist/json.js"
    },
    "./text": {
      "types": "./dist/text.d.ts",
      "import": "./dist/text.js",
      "default": "./dist/text.js"
    },
    "./text-diff": {
      "types": "./dist/text-diff.d.ts",
      "import": "./dist/text-diff.js",
      "default": "./dist/text-diff.js"
    },
    "./timestamp": {
      "types": "./dist/timestamp.d.ts",
      "import": "./dist/timestamp.js",
      "default": "./dist/timestamp.js"
    },
    "./word-counter": {
      "types": "./dist/word-counter.d.ts",
      "import": "./dist/word-counter.js",
      "default": "./dist/word-counter.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js",
      "default": "./dist/pdf.js"
    },
    "./pdf-preview": {
      "types": "./dist/pdf-preview.d.ts",
      "import": "./dist/pdf-preview.js",
      "default": "./dist/pdf-preview.js"
    },
    "./pdf.worker.js": "./dist/pdf.worker.js",
    "./pdfjs.worker.js": "./dist/pdfjs.worker.js",
    "./pdf-build.json": "./dist/pdf-build.json",
    "./pdf-assets/*": "./dist/pdf-assets/*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test src/*.test.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "prepack": "npm run build && npm run test && npm run validate:catalog"
  },
  "dependencies": {
    "diff": "9.0.0"
  }
}
